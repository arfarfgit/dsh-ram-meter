{
  "name": "@npmghost/dsh-ram-meter",
  "version": "0.1.2",
  "icon": "./assets/icon-180.png",
  "description": "Live host memory and heap-ceiling meter for DeepSeek Harness.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "memory",
    "ram",
    "heap",
    "monitor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arfarfgit/dsh-ram-meter.git"
  },
  "homepage": "https://github.com/arfarfgit/dsh-ram-meter#readme",
  "bugs": {
    "url": "https://github.com/arfarfgit/dsh-ram-meter/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale",
    "icon.svg",
    "assets"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.2-rc.2 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.2 <0.3.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsdown": "^0.23.7",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
